# StudyTrack Environment Variables Configuration
# Copy this file to .env and configure your actual local credentials

# Django Secret Key (generate a strong key for production)
SECRET_KEY=django-insecure-studytrack-local-development-key-change-in-production

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL Database Configuration
DB_ENGINE=django.db.backends.mysql
DB_NAME=studytrack_db
DB_USER=studytrack_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to True only if running tests in an offline environment without MySQL
USE_SQLITE=False
